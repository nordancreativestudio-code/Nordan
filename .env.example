# Copiar para .env.local e preencher. Nunca fazer commit das chaves.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor (route handlers / server actions). Nunca expor no browser.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública do site (para os links do email de login)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Calendar (convites das sessões). Só no servidor. Refresh token: node --env-file=.env.local scripts/google-token.mjs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
